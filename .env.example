# 复制成 .env 后按需修改：`cp .env.example .env`。不改也能直接 docker compose up。

# 对外访问地址。经反代 / 隧道暴露时必填（例如 https://subhd.example.com），
# 否则生成的 manifest 和字幕直链会指向容器自己看到的地址，Stremio 点不动。
# 直接 http://<机器IP>:7000 访问（Stremio 和它在同一网络）时留空即可。
ADDON_BASE_URL=

# 端口：宿主机和容器用同一个值，默认 7000。宿主机 7000 被占用时改这里。
PORT=7000

# 站点镜像，第一个优先，失败自动切换
SUBHD_DOMAINS=subhd.tv,subhd.me,subhd.one,subhd.top,subhd.cc,subhd.com

# 两次下载之间的最小间隔（毫秒）。SubHD 按 IP 限流，别调太小
DOWNLOAD_INTERVAL_MS=1500

# 出口池：SubHD 按出口 IP 记账，被拍一个就换下一个。逗号 / 分号 / 换行分隔，
# 支持 http:// 和 socks5://（socks5 可带账号密码）。留空 = 就用这台机器自己的 IP。
# 也可以填「你自己开的隧道」：在客户端上 `ssh -N -R 1080:127.0.0.1:7890 user@这台机器`，
# 这里写 socks5://127.0.0.1:1080，去 SubHD 的那一跳就从客户端那条网络出去（见 README）。
SUBHD_PROXIES=

# 一次下载最多换几个出口（池子里有几个就以几个为上限）
SUBHD_PROXY_ATTEMPTS=3

# 某个出口被站点拍回来 / 连不上之后冷落多久（毫秒）；连着被拍翻倍，上限 30 分钟
SUBHD_PROXY_COOLDOWN_MS=90000
SUBHD_PROXY_MAX_COOLDOWN_MS=1800000

# 连代理本身的超时（毫秒）：节点挂了要快点换下一个，别让用户干等
SUBHD_PROXY_CONNECT_MS=10000

# 允许读进内存的字幕体积（字节，默认 256MB）：SUP/PGS 图形字幕一份常有几十上百 MB
MAX_ARCHIVE_BYTES=268435456

# 点开一条字幕后顺手预热的「下面几条」（0 关掉）
PREFETCH_NEIGHBORS=2

# 图形字幕（SUP / PGS）是否列进列表（0 = 只列文本字幕）
INCLUDE_IMAGE_SUBTITLES=1

# info / debug / silent
LOG_LEVEL=info

# ─────────────────────────── 字幕来源 ───────────────────────────
# 这版有三个来源：SubHD / 迅雷字幕 / 射手（伪）assrt.net。逗号分隔，顺序就是字幕列表里的顺序。
# 只要 SubHD（老行为）：SUBHD_SOURCES=subhd
# 关掉 SubHD 只留另外两个：SUBHD_SOURCES=thunder,assrt
SUBHD_SOURCES=subhd,thunder,assrt

# 射手（伪）的 API token（在 assrt.net 登录后「个人中心」里拿）。填了就走官方 API，最稳；
# 不填就走网页（不用注册，但站点偶尔会掐出口 IP，而且网页上很多条目是 .rar/.7z）。
ASSRT_TOKEN=

# 射手（伪）的线路，第一个优先
ASSRT_DOMAINS=assrt.net,2.assrt.net

# 迅雷字幕：一次最多列多少条、片名至少要命中几个词（1 = 命中一个词就算）
THUNDER_MAX_RESULTS=30
THUNDER_MIN_TOKENS=1

# 某个来源最多等多久（毫秒），到点先用其它来源的结果；客户端自己有超时
SOURCE_DEADLINE_MS=3500
# 某个来源连续失败几次先跳过它、跳过多久（毫秒）
SOURCE_FAILURE_THRESHOLD=2
SOURCE_COOLDOWN_MS=120000
# 第一个来源有结果后，再给其它来源多久「补进来」
SOURCE_LATE_GRACE_MS=1000
# 迅雷接口单次请求超时（http/https 同时发，取先回的）
THUNDER_TIMEOUT_MS=2500
# 想固定只走某一协议：把 THUNDER_API_BASE 写成 http://api-shoulei-ssl.xunlei.com 或 https://…
# THUNDER_API_BASE=https://api-shoulei-ssl.xunlei.com
ASSRT_TIMEOUT_MS=5000

# ── 可选：迅雷走 Cloudflare 出口（Vercel 机房直连迅雷常被掐断）──
# Worker 代码与部署步骤见 tools/cf-proxy/README.md
THUNDER_PROXY_URL=
THUNDER_PROXY_SECRET=
